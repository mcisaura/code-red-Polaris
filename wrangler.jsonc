{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "airdeck",
  "main": "worker/worker.js",
  // Must not be newer than the workerd bundled with the installed wrangler.
  "compatibility_date": "2026-11-10",
  "assets": {
    // Built by `npm run build` (scripts/build-site.mjs): only the site's public files.
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker handles every request first (/ and /api/*) and falls back to env.ASSETS.
    "run_worker_first": true,
    // Serve files exactly as named (/index.html stays /index.html, no redirects to clean URLs).
    "html_handling": "none"
  }
  // Hosted audio (library.public.json) ships as static assets (dist/music/, copied from public-music/ by the build),
  // which is free and needs no card. Optional: to serve it from R2 instead, create a bucket
  // (`npx wrangler r2 bucket create airdeck-music`), run `npm run upload-music`, and add:
  // "r2_buckets": [{ "binding": "MUSIC", "bucket_name": "airdeck-music" }]
}
